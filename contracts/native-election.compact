// NATIVE RESEARCH CONTRACT: fresh execution stages are in docs/CONTINUATION_RESULTS.md.
// Three-choice encrypted voting with native Jubjub operations and threshold tallying.
// It uses Compact's Jubjub operations and proves encryption/decryption relations
// in the native circuits. Key configuration uses a centralized private dealer;
// independent distributed key generation and production operations remain work.
pragma language_version 0.23.0;

import CompactStandardLibrary;

// Coordinates can be stored and persistently hashed in the pinned toolchain;
// the opaque JubjubPoint itself must not be nested in public records or hashes.
export type PointCoordinates = Vector<2, Field>;
export type CandidatePoints = Vector<3, PointCoordinates>;

export sealed ledger electionId: Bytes<32>;
export sealed ledger manifestDigest: Bytes<32>;
export ledger configurationDigest: Bytes<32>;
export sealed ledger administrator: Bytes<32>;
export sealed ledger opensAt: Uint<64>;
export sealed ledger closesAt: Uint<64>;
export ledger publicKey: PointCoordinates;
export ledger coefficientKey: PointCoordinates;
export ledger trusteeKeys: CandidatePoints;
export ledger keysConfigured: Boolean;

// 0=enrollment, 1=voting, 2=frozen/decrypting, 3=finalized.
export ledger phase: Uint<8>;
export ledger members: MerkleTree<10, Bytes<32>>;
export ledger enrolled: Set<Bytes<32>>;
export ledger spent: Set<Bytes<32>>;
export ledger accepted: Uint<32>;
export ledger ballotA: Map<Uint<32>, CandidatePoints>;
export ledger ballotB: Map<Uint<32>, CandidatePoints>;
export ledger nullifiers: Map<Uint<32>, Bytes<32>>;
export ledger ballotReceipts: Map<Uint<32>, Bytes<32>>;
export ledger receipts: Set<Bytes<32>>;
export ledger aggregateA: CandidatePoints;
export ledger aggregateB: CandidatePoints;
export ledger submittedTrustees: Set<Uint<8>>;
export ledger decryptionShares: Map<Uint<8>, CandidatePoints>;
export ledger finalizedTotals: Vector<3, Uint<32>>;

witness setupSecret(): Field;
witness setupSlope(): Field;
witness administratorSecret(): Bytes<32>;
witness voterSecret(): Bytes<32>;
witness eligibilityPath(): MerkleTreePath<10, Bytes<32>>;
witness selection(): Uint<8>;
witness ballotRandomness(): Vector<3, Field>;
witness trusteeSecretShare(): Field;

// Scalar values are carried in Field by the pinned 0.31.x API, but MUST be
// bounded to the Jubjub subgroup order. Arithmetic modulo Field is NOT scalar
// arithmetic modulo q. No secret-share polynomial arithmetic occurs in Field.
pure circuit canonicalScalar(s: Field): [] {
  // Compact's widest Uint is 248 bits. Split canonical little-endian Field
  // bytes into one high byte and a checked 248-bit low limb. This compares to
  // q = 14*2^248 + 222104516725044372704429320860625768980218979470098935457522536959433977015.
  const encoded = s as Bytes<32>;
  const high = encoded[31];
  const low = (s - (high as Field) *
    (452312848583266388373324160190187140051835877600158453279131187530910662656 as Field)) as Uint<248>;
  assert(high < 14 || (high == 14 && low < 222104516725044372704429320860625768980218979470098935457522536959433977015),
    "noncanonical Jubjub scalar");
}

pure circuit nonzeroScalar(s: Field): [] {
  canonicalScalar(s);
  assert(s != 0, "zero private scalar");
}

pure circuit coordinates(p: JubjubPoint): PointCoordinates {
  return [jubjubPointX(p), jubjubPointY(p)];
}

// Only points generated by this contract reach these helpers in impure calls.
// constructJubjubPoint does not itself validate arbitrary external coordinates.
// The exported pure helpers are arithmetic utilities, NOT point/proof validators.
pure circuit point(p: PointCoordinates): JubjubPoint {
  return constructJubjubPoint(p[0], p[1]);
}

export pure circuit nativePublicKey(s: Field): PointCoordinates {
  canonicalScalar(s);
  return coordinates(ecMulGenerator(s));
}

export pure circuit addPoints(a: PointCoordinates, b: PointCoordinates): PointCoordinates {
  return coordinates(ecAdd(point(a), point(b)));
}

export pure circuit scalePoint(a: PointCoordinates, s: Field): PointCoordinates {
  canonicalScalar(s);
  return coordinates(ecMul(point(a), s));
}

export pure circuit negatePoint(a: PointCoordinates): PointCoordinates {
  return scalePoint(a, 6554484396890773809930967563523245729705921265872317281365359162392183254198 as Field);
}

export pure circuit samePoint(a: PointCoordinates, b: PointCoordinates): Boolean {
  return a[0] == b[0] && a[1] == b[1];
}

export pure circuit administratorIdentity(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "ballot-native:admin:v1"), sk]);
}

export pure circuit memberIdentity(id: Bytes<32>, sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "ballot-native:member:v1"), id, sk]);
}

export pure circuit voterNullifier(id: Bytes<32>, sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "ballot-native:nullifier:v1"), id, sk]);
}

export pure circuit configurationDigestFor(
  id: Bytes<32>, manifest: Bytes<32>, adminIdentity: Bytes<32>,
  opening: Uint<64>, closing: Uint<64>, key: PointCoordinates,
  coefficient: PointCoordinates, keys: CandidatePoints
): Bytes<32> {
  const keyDigest = persistentHash<Vector<5, PointCoordinates>>(
    [key, coefficient, keys[0], keys[1], keys[2]]);
  const timeDigest = persistentHash<Vector<2, Uint<64>>>([opening, closing]);
  return persistentHash<Vector<6, Bytes<32>>>([
    pad(32, "ballot-native:config:v1"), id, manifest, adminIdentity, keyDigest, timeDigest
  ]);
}

export pure circuit receiptDigest(
  id: Bytes<32>, configuration: Bytes<32>, nul: Bytes<32>,
  a: CandidatePoints, b: CandidatePoints
): Bytes<32> {
  const ciphertextDigest = persistentHash<Vector<6, PointCoordinates>>(
    [a[0], a[1], a[2], b[0], b[1], b[2]]);
  return persistentHash<Vector<5, Bytes<32>>>(
    [pad(32, "ballot-native:receipt:v1"), id, configuration, nul, ciphertextDigest]);
}

constructor(
  id: Bytes<32>, manifest: Bytes<32>, adminIdentity: Bytes<32>,
  opening: Uint<64>, closing: Uint<64>
) {
  assert(opening < closing, "invalid voting window");
  assert(id != default<Bytes<32>>, "empty election id");
  assert(manifest != default<Bytes<32>>, "empty manifest digest");
  assert(adminIdentity != default<Bytes<32>>, "empty administrator identity");
  const identity = nativePublicKey(0);
  electionId = disclose(id);
  manifestDigest = disclose(manifest);
  administrator = disclose(adminIdentity);
  opensAt = disclose(opening);
  closesAt = disclose(closing);
  publicKey = identity;
  coefficientKey = identity;
  trusteeKeys = [identity, identity, identity];
  configurationDigest = default<Bytes<32>>;
  keysConfigured = false;
  aggregateA = [identity, identity, identity];
  aggregateB = [identity, identity, identity];
  finalizedTotals = [0, 0, 0];
  accepted = 0;
  phase = 0;
}

// Deployment does not prove constructor execution. Authenticate the expected
// initial state and verifier keys before trusting an election. Secret-key
// provenance is therefore established in this PROVED impure setup circuit,
// not by a private witness evaluated only during deployment.
export circuit configureKeys(): [] {
  assert(administratorIdentity(administratorSecret()) == administrator, "administrator required");
  assert(phase == 0 && !keysConfigured, "keys already configured or election started");
  assert(opensAt < closesAt, "invalid voting window");
  assert(electionId != default<Bytes<32>>, "empty election id");
  assert(manifestDigest != default<Bytes<32>>, "empty manifest digest");
  assert(administrator != default<Bytes<32>>, "empty administrator identity");
  assert(blockTimeLt(opensAt), "key setup deadline passed");
  assert(enrolled.isEmpty() && spent.isEmpty() && accepted == 0, "setup requires empty election");
  assert(submittedTrustees.isEmpty(), "setup requires no trustee submissions");
  const x = setupSecret();
  const slope = setupSlope();
  nonzeroScalar(x);
  nonzeroScalar(slope);
  const identity = nativePublicKey(0);
  assert(samePoint(aggregateA[0], identity) && samePoint(aggregateA[1], identity) && samePoint(aggregateA[2], identity), "setup requires empty aggregate");
  assert(samePoint(aggregateB[0], identity) && samePoint(aggregateB[1], identity) && samePoint(aggregateB[2], identity), "setup requires empty aggregate");
  const key = nativePublicKey(x);
  const coefficient = nativePublicKey(slope);
  // Shamir shares are x+i*slope modulo q, computed privately by the dealer.
  // Derive their PUBLIC commitments by point addition, never Field arithmetic.
  const k1 = addPoints(key, coefficient);
  const k2 = addPoints(k1, coefficient);
  const k3 = addPoints(k2, coefficient);
  assert(!samePoint(key, identity), "identity election key");
  assert(!samePoint(coefficient, identity), "identity coefficient key");
  assert(!samePoint(k1, identity) && !samePoint(k2, identity) && !samePoint(k3, identity),
    "identity trustee key");
  publicKey = disclose(key);
  coefficientKey = disclose(coefficient);
  trusteeKeys = disclose([k1, k2, k3]);
  configurationDigest = disclose(configurationDigestFor(electionId, manifestDigest, administrator,
    opensAt, closesAt, key, coefficient, [k1, k2, k3]));
  finalizedTotals = [0, 0, 0];
  keysConfigured = true;
}

export circuit enroll(member: Bytes<32>): [] {
  assert(administratorIdentity(administratorSecret()) == administrator, "administrator required");
  assert(keysConfigured, "keys not configured");
  assert(phase == 0, "enrollment is frozen");
  assert(blockTimeLt(opensAt), "enrollment deadline passed");
  assert(enrolled.size() < 1024, "prototype electorate is full");
  assert(member != default<Bytes<32>>, "empty member identity");
  const identity = disclose(member);
  assert(!enrolled.member(identity), "member already enrolled");
  enrolled.insert(identity);
  members.insert(identity);
}

export circuit openVoting(): [] {
  assert(keysConfigured, "keys not configured");
  assert(phase == 0, "election already opened or closed");
  assert(blockTimeGte(opensAt), "voting has not started");
  assert(blockTimeLt(closesAt), "voting deadline passed");
  assert(!enrolled.isEmpty(), "no voters enrolled");
  phase = 1;
}

// Ciphertexts are COMPUTED inside the circuit. No externally supplied digest,
// ciphertext or boolean can bypass the exactly-one-choice encryption relation.
export circuit castBallot(): Bytes<32> {
  assert(phase == 1, "voting is not open");
  assert(blockTimeGte(opensAt), "voting has not started");
  assert(blockTimeLt(closesAt), "voting deadline passed");
  assert(accepted < 1024, "prototype ballot capacity reached");
  const secret = voterSecret();
  const path = eligibilityPath();
  assert(path.leaf == memberIdentity(electionId, secret), "path not bound to voter secret");
  assert(members.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(path))), "unknown electorate root");
  const nul = disclose(voterNullifier(electionId, secret));
  assert(!spent.member(nul), "voter already voted");
  const choice = selection();
  assert(choice < 3, "invalid choice");
  const r = ballotRandomness();
  nonzeroScalar(r[0]);
  nonzeroScalar(r[1]);
  nonzeroScalar(r[2]);
  // This catches equal masks; it cannot prove randomness quality or independence.
  assert(r[0] != r[1] && r[0] != r[2] && r[1] != r[2], "reused candidate randomness");
  const a = disclose([nativePublicKey(r[0]), nativePublicKey(r[1]), nativePublicKey(r[2])]);
  const b = disclose([
    addPoints(scalePoint(publicKey, r[0]), nativePublicKey(choice == 0 ? 1 : 0)),
    addPoints(scalePoint(publicKey, r[1]), nativePublicKey(choice == 1 ? 1 : 0)),
    addPoints(scalePoint(publicKey, r[2]), nativePublicKey(choice == 2 ? 1 : 0))
  ]);
  const receipt = disclose(receiptDigest(electionId, configurationDigest, nul, a, b));
  ballotA.insert(accepted, a);
  ballotB.insert(accepted, b);
  nullifiers.insert(accepted, nul);
  ballotReceipts.insert(accepted, receipt);
  spent.insert(nul);
  receipts.insert(receipt);
  aggregateA = [addPoints(aggregateA[0], a[0]), addPoints(aggregateA[1], a[1]), addPoints(aggregateA[2], a[2])];
  aggregateB = [addPoints(aggregateB[0], b[0]), addPoints(aggregateB[1], b[1]), addPoints(aggregateB[2], b[2])];
  accepted = (accepted + 1) as Uint<32>;
  return receipt;
}

export circuit closeVoting(): [] {
  assert(keysConfigured, "keys not configured");
  assert(phase == 0 || phase == 1, "election already closed");
  assert(blockTimeGte(closesAt), "voting has not ended");
  phase = 2;
}

// The ZK relation proves knowledge of the registered secret share AND correct
// partial decryption of the COMPLETE frozen aggregate. There is no aggregate
// argument allowing callers to ask this endpoint to decrypt a ballot subset.
export circuit submitDecryption(index: Uint<8>): [] {
  assert(phase == 2, "election is not frozen for decryption");
  assert(index >= 1 && index <= 3, "invalid trustee index");
  const trustee = disclose(index);
  assert(!submittedTrustees.member(trustee), "trustee already submitted");
  const share = trusteeSecretShare();
  nonzeroScalar(share);
  const expected = trustee == 1 ? trusteeKeys[0] : (trustee == 2 ? trusteeKeys[1] : trusteeKeys[2]);
  assert(samePoint(nativePublicKey(share), expected), "wrong trustee secret share");
  const partial = disclose([
    scalePoint(aggregateA[0], share), scalePoint(aggregateA[1], share), scalePoint(aggregateA[2], share)
  ]);
  decryptionShares.insert(trustee, partial);
  submittedTrustees.insert(trustee);
}

// Integer-scaled Lagrange equations avoid inversion modulo q and therefore
// cannot accidentally use Compact Field's different modulus. All points in
// this relation originate from generated subgroup points. Counts <=1024 make
// the factor-two equation for trustees 1+3 injective over possible tallies.
pure circuit checkTotal(
  first: Uint<8>, second: Uint<8>, b: PointCoordinates,
  dFirst: PointCoordinates, dSecond: PointCoordinates, total: Uint<32>
): [] {
  const message = nativePublicKey(total as Field);
  if (first == 1 && second == 2) {
    assert(samePoint(addPoints(b, dSecond), addPoints(message, scalePoint(dFirst, 2))), "incorrect tally");
  } else if (first == 1 && second == 3) {
    assert(samePoint(addPoints(scalePoint(b, 2), dSecond), addPoints(scalePoint(message, 2), scalePoint(dFirst, 3))), "incorrect tally");
  } else {
    assert(first == 2 && second == 3, "invalid trustee pair");
    assert(samePoint(addPoints(b, scalePoint(dSecond, 2)), addPoints(message, scalePoint(dFirst, 3))), "incorrect tally");
  }
}

export circuit finalize(first: Uint<8>, second: Uint<8>, totals: Vector<3, Uint<32>>): [] {
  assert(phase == 2, "election is not frozen for finalization");
  assert(first >= 1 && second <= 3 && first < second, "invalid trustee pair");
  const i = disclose(first);
  const j = disclose(second);
  // Totals are public output. Declare that before short-circuit checks that
  // read the ledger, as required by the compiler's disclosure analysis.
  const publicTotals = disclose(totals);
  assert(submittedTrustees.member(i) && submittedTrustees.member(j), "two verified trustees required");
  assert(publicTotals[0] <= accepted && publicTotals[1] <= accepted && publicTotals[2] <= accepted, "total exceeds ballot count");
  assert((publicTotals[0] as Uint<64>) + (publicTotals[1] as Uint<64>) + (publicTotals[2] as Uint<64>) == (accepted as Uint<64>), "totals do not sum to ballot count");
  const dFirst = decryptionShares.lookup(i);
  const dSecond = decryptionShares.lookup(j);
  checkTotal(i, j, aggregateB[0], dFirst[0], dSecond[0], publicTotals[0]);
  checkTotal(i, j, aggregateB[1], dFirst[1], dSecond[1], publicTotals[1]);
  checkTotal(i, j, aggregateB[2], dFirst[2], dSecond[2], publicTotals[2]);
  finalizedTotals = publicTotals;
  phase = 3;
}
